FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources || true; \
    rm -f /etc/apt/sources.list || true; \
    printf "%s\n" \
      "deb https://deb.debian.org/debian bookworm main" \
      "deb https://deb.debian.org/debian bookworm-updates main" \
      "deb https://security.debian.org/debian-security bookworm-security main" \
      > /etc/apt/sources.list.d/99-https.list; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; \
    apt-get update; \
    apt-get install -y --no-install-recommends build-essential libpq-dev; \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

# Copy dependency files first for caching
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen

# Copy app
COPY . /app

EXPOSE 8000

# Prod server (Django WSGI)
CMD ["uv", "run", "gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
