{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django runserver in Docker (attach :5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/backend", "remoteRoot": "/app" }
      ],
      "preLaunchTask": "open-swagger",
      "justMyCode": false
    },
    {
      "name": "Pytest in Docker (attach :5679)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5679 },
      "pathMappings": [
        { "localRoot": "${workspaceFolder}/backend", "remoteRoot": "/app" }
      ],
      "preLaunchTask": "pytest+swagger",
      "postDebugTask": "docker-stop-pytest-debug",
      "justMyCode": false,
      "subProcess": true
    }
  ]
}
