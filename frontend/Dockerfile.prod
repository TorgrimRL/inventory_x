# Build stage
FROM node:20-alpine AS build

WORKDIR /app

RUN npm i -g npm@11.10.0

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Runtime stage (static files via nginx)
FROM nginx:alpine

COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80
