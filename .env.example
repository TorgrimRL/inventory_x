# Django
# Local development only. Use DEBUG=False in production.
DEBUG=True

# Replace this in your real .env file.
SECRET_KEY=change-me-please

# Postgres
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory_db

# Use "db" when running with Docker Compose.
# Use "localhost" instead of "db" if running Django directly on your machine.
DATABASE_URL=postgres://inventory:inventory@db:5432/inventory_db

# Hosts / proxy / TLS-ready settings
# Add your deployed domain here in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origins allowed to make authenticated requests.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Local development only. Use True behind HTTPS in production.
SECURE_SSL_REDIRECT=False

# Email / SMTP
# Required for password reset and invitation emails.
EMAIL_HOST_USER=change-me-please
EMAIL_HOST_PASSWORD=change-me-please
EMAIL_HOST=change-me-please
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Auth0 configuration
# Required only for Auth0 / Google login.
# Example AUTH0_DOMAIN: dev-example.eu.auth0.com
AUTH0_DOMAIN=change-me-please
AUTH0_CLIENT_ID=change-me-please
AUTH0_CLIENT_SECRET=change-me-please

# Redis configuration
# Used for cache/session-related functionality.
REDIS_URL=redis://redis:6379/1